---
const faqs = [
  {
    question: "Is SPH currently accepting housing applications?",
    answer:
      "Not yet. Our housing programs are currently in development. When programs become operational, application procedures and eligibility requirements will be published on this website.",
  },
  {
    question: "Who will SPH serve?",
    answer:
      "SPH is developing programs intended to support veterans, individuals and families experiencing housing instability, single mothers, and other populations facing barriers to safe and affordable housing. Specific eligibility requirements will depend on the program.",
  },
  {
    question: "Where will housing be available?",
    answer:
      "SPH is currently developing its housing strategy and partnerships. Locations will be announced as programs become operational.",
  },
  {
    question: "Can a caseworker refer someone?",
    answer:
      "SPH is developing a referral pathway for agencies and caseworkers. Interested agencies can contact SPH to discuss future partnership opportunities.",
  },
  {
    question: "Does contacting SPH guarantee housing?",
    answer:
      "No. An inquiry is not an application and does not guarantee placement. Housing eligibility, availability, and application procedures will be explained when programs officially open.",
  },
];
---

<section class="faq-section" id="faq" aria-labelledby="faq-title">
  <div class="faq-layout">
    <div class="faq-intro">
      <p class="faq-eyebrow">
        <span aria-hidden="true"></span>
        Frequently asked
      </p>
      <h2 id="faq-title">Questions? Let’s make things clear.</h2>
      <p>
        The program is still taking shape. These answers reflect what is confirmed today
        and will be updated as locations, policies, and availability are finalized.
      </p>
      <a
        href="#contact"
        data-contact-open
        aria-haspopup="dialog"
        aria-controls="contact-dialog"
      >
        Contact SPH
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="faq-list">
      {
        faqs.map((faq, index) => (
          <details name="sph-faq" open={index === 0}>
            <summary>{faq.question}</summary>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
