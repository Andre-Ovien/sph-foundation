<section class="site-shell" aria-label="SPH Foundation introduction">
  <header class="site-header">
    <a class="wordmark" href="#home" aria-label="SPH Foundation home">
      <span class="wordmark-house" aria-hidden="true">
        <span></span>
      </span>
      <span class="wordmark-copy">
        <strong>SPH</strong>
        <small>Foundation</small>
      </span>
    </a>

    <nav class="primary-nav" aria-label="Primary navigation">
      <a class="is-active" href="#home">Home</a>
      <a href="#purpose">Our purpose</a>
      <a href="#home">For agencies</a>
      <a href="#partnership">Partners</a>
    </nav>

    <a
      class="header-action"
      href="#get-started"
      data-start-open
      data-start-pathway="individual"
      aria-haspopup="dialog"
      aria-controls="get-started-dialog"
    >
      Get started
      <span class="action-orb" aria-hidden="true">↗</span>
    </a>
  </header>

  <figure class="hero-card" id="home" aria-labelledby="hero-title">
    <img
      class="hero-image"
      src="/images/sph-housing-concept.jpg"
      width="1672"
      height="941"
      alt="Concept view of a welcoming multifamily apartment community with Black residents in a landscaped courtyard on a sunny day."
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="hero-shade" aria-hidden="true"></div>

    <div class="hero-content" id="our-vision">
      <h1 id="hero-title">
        A stable place
        <span>to call home.</span>
      </h1>

      <p class="hero-intro">
        SPH Foundation is developing an affordable housing initiative for individuals and
        households seeking stability—and the agencies supporting them.
      </p>

      <a
        class="hero-action"
        id="housing-interest"
        href="#get-started"
        data-start-open
        data-start-pathway="individual"
        aria-haspopup="dialog"
        aria-controls="get-started-dialog"
      >
        Share your housing needs
        <span aria-hidden="true">↗</span>
      </a>
    </div>

  </figure>
</section>
