---
const homeTypes = [
  {
    title: "Studio apartment",
    description: "A compact, self-contained option designed for a smaller household.",
  },
  {
    title: "1 bedroom",
    description: "A private bedroom paired with a separate everyday living area.",
  },
  {
    title: "2 bedrooms",
    description: "Additional sleeping space for households that may need more room.",
  },
];

// Reserved for the future program-details section.
const futureProgramDetails = [
  {
    title: "Affordability",
    copy: "Lower-cost housing is the goal. Final rates will be shared once confirmed.",
  },
  {
    title: "Utilities",
    copy: "Included services will be listed clearly for every available home.",
  },
  {
    title: "Length of stay",
    copy: "Shorter- and longer-term arrangements are being considered.",
  },
];
---

<section
  class="housing-program"
  id="housing-program"
  aria-labelledby="housing-program-title"
  data-housing-program
>
  <div class="housing-program-stage">
    <header class="housing-program-intro">
      <div class="housing-program-heading">
        <h2 class="housing-program-title kinetic-title" id="housing-program-title" data-kinetic-title>
          <span class="sr-only">Because everyone deserves a safe place to call home.</span>
          <span aria-hidden="true">
            {"Because everyone deserves".split(" ").map(word => (
              <><span class="kinetic-line"><span class="kinetic-letter">{word}</span></span>{" "}</>
            ))}
            <span class="kinetic-phrase">
              {"a safe place".split(" ").map((word, index) => (
                <>{index > 0 && " "}<span class:list={["kinetic-line", { "kinetic-line-emphasis": index > 0 }]}><span class="kinetic-letter">{word}</span></span></>
              ))}
              <span class="kinetic-underline"></span>
            </span>{" "}
            {"to call home.".split(" ").map(word => (
              <><span class="kinetic-line kinetic-line-emphasis"><span class="kinetic-letter">{word}</span></span>{" "}</>
            ))}
          </span>
        </h2>
        <p>
          Stable Path Housing Foundation is developing housing programs designed to
          support veterans experiencing housing instability, individuals and families
          with limited income, single mothers and families working toward stability,
          survivors of domestic violence who need safe housing, and individuals
          transitioning from unstable or temporary living situations.
        </p>
      </div>
    </header>

    <div class="apartment-sequence" data-program-track>
      <div class="apartment-stack" aria-label="Illustrative views of intended home types">
        {
          homeTypes.map((home, index) => (
            <div
              class={`apartment-floor apartment-floor-${index + 1}`}
              role="img"
              aria-label={`${home.title}, illustrative interior`}
            />
          ))
        }
      </div>
    </div>

    <div class="housing-program-ledger" aria-label="Intended home types">
      {
        homeTypes.map((home) => (
          <div>
            <h3>{home.title}</h3>
            <p>{home.description}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .housing-program-heading { align-items: center; }
  .kinetic-title { width: 100%; max-width: none; color: #a47a0e; font-family: Georgia, "Times New Roman", serif; font-size: clamp(2.8rem, 4.35vw, 5.15rem); font-weight: 400; letter-spacing: -.045em; line-height: 1.08; text-wrap: balance; }
  .kinetic-line { display: inline-block; overflow: hidden; vertical-align: bottom; padding: .08em .08em .14em; margin: -.08em -.08em -.14em; white-space: nowrap; }
  .kinetic-letter { display: inline-block; transform-origin: 50% 100%; }
  .kinetic-line-emphasis { font-style: italic; }
  .kinetic-phrase { position: relative; display: inline-block; white-space: nowrap; }
  .kinetic-underline { position: absolute; left: 0; right: 0; bottom: -.06em; height: 3px; border-radius: 50%; background: currentColor; transform-origin: left; }
  .kinetic-title.is-ready:not(.is-revealed) .kinetic-letter { transform: translateY(115%) rotate(5deg); opacity: 0; }
  .kinetic-title.is-ready:not(.is-revealed) .kinetic-underline { transform: scaleX(0); }
  @media (prefers-reduced-motion: reduce) {
    .kinetic-title .kinetic-letter, .kinetic-title .kinetic-underline { transform: none !important; opacity: 1 !important; }
  }
</style>

<script>
  const kineticTitle = document.querySelector<HTMLElement>("[data-kinetic-title]");
  if (kineticTitle && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    kineticTitle.classList.add("is-ready");
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      observer.disconnect();
      const letters = kineticTitle.querySelectorAll<HTMLElement>(".kinetic-letter");
      letters.forEach((letter, index) => {
        letter.animate([
          { transform: "translateY(115%) rotate(5deg)", opacity: 0 },
          { transform: "translateY(0) rotate(0)", opacity: 1 },
        ], { duration: 950, delay: index * 65, easing: "cubic-bezier(.22,1,.36,1)", fill: "both" });
      });
      const underline = kineticTitle.querySelector<HTMLElement>(".kinetic-underline")!;
      const finish = underline.animate([{ transform: "scaleX(0)" }, { transform: "scaleX(1)" }], {
        duration: 650, delay: 1050, easing: "cubic-bezier(.22,1,.36,1)", fill: "both",
      });
      finish.finished.then(() => kineticTitle.classList.add("is-revealed")).catch(() => {});
    }, { threshold: 0.15 });
    observer.observe(kineticTitle);
  }
</script>

<script>
  const setupHousingProgramMotion = () => {
    const section = document.querySelector<HTMLElement>("[data-housing-program]");
    const track = section?.querySelector<HTMLElement>("[data-program-track]");

    if (!section || !track || section.dataset.motionBound === "true") return;

    section.dataset.motionBound = "true";
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let frame = 0;
    let activeFloor = -1;

    const clamp = (value: number) => Math.min(1, Math.max(0, value));
    const smoothstep = (value: number) => value * value * (3 - 2 * value);
    const phaseProgress = (value: number, start: number, end: number) =>
      smoothstep(clamp((value - start) / (end - start)));

    const render = () => {
      frame = 0;
      if (!section.classList.contains("housing-sequence-ready")) return;

      const trackRect = track.getBoundingClientRect();
      const viewportHeight = Math.max(document.documentElement.clientHeight, 1);
      const travel = Math.max(trackRect.height - viewportHeight, 1);
      const scrollProgress = clamp(-trackRect.top / travel);
      const entryDistance = viewportHeight * 0.78;
      const studioProgress = smoothstep(
        clamp((entryDistance - trackRect.top) / entryDistance),
      );
      const oneBedroomProgress = phaseProgress(scrollProgress, 0.1, 0.42);
      const twoBedroomProgress = phaseProgress(scrollProgress, 0.55, 0.87);

      track.style.setProperty("--studio-y", `${(1 - studioProgress) * 14}%`);
      track.style.setProperty("--studio-opacity", studioProgress.toFixed(3));
      track.style.setProperty(
        "--one-bedroom-x",
        `${(oneBedroomProgress - 1) * 102}%`,
      );
      track.style.setProperty(
        "--two-bedroom-x",
        `${(1 - twoBedroomProgress) * 102}%`,
      );

      const nextFloor =
        twoBedroomProgress >= 0.5 ? 2 : oneBedroomProgress >= 0.5 ? 1 : 0;

      if (nextFloor !== activeFloor) {
        activeFloor = nextFloor;
        section.dataset.activeFloor = String(nextFloor);
      }
    };

    const requestRender = () => {
      if (frame) return;
      frame = window.requestAnimationFrame(render);
    };

    const syncMotionMode = () => {
      const canEnhance =
        !reducedMotion.matches && CSS.supports("position", "sticky");

      section.classList.toggle("housing-sequence-ready", canEnhance);

      if (!canEnhance) {
        track.removeAttribute("style");
        section.removeAttribute("data-active-floor");
        activeFloor = -1;
      }

      requestRender();
    };

    window.addEventListener("scroll", requestRender, { passive: true });
    window.addEventListener("resize", requestRender, { passive: true });
    window.addEventListener("orientationchange", requestRender, { passive: true });
    window.addEventListener("pageshow", requestRender, { passive: true });
    reducedMotion.addEventListener("change", syncMotionMode);
    syncMotionMode();
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupHousingProgramMotion, { once: true });
  } else {
    setupHousingProgramMotion();
  }
</script>
